---
import Search from './Search.astro';

const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/memberships', label: 'Memberships' },
  { href: '/camps', label: 'Camps & Training' },
  { href: '/schedule', label: 'Calendar' },
  { href: '/events', label: 'Events' },
  { href: '/team', label: 'Team' },
  { href: '/contact', label: 'Contact' },
];

function isCurrent(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/" aria-label="Arizona Pole Vault Academy home">
      <img
        src="/images/azpva-logo.png"
        alt="Arizona Pole Vault Academy"
        class="logo-img"
        width="640"
        height="270"
      />
    </a>

    <nav class="nav" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-tools">
      <div class="header-search desktop-search" aria-label="Site search">
        <Search id="pagefind-search-desktop" />
      </div>
      <a class="btn btn-primary header-cta" href="tel:+14807666017">Call</a>
    </div>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" id="menu-toggle">
      Menu
    </button>
  </div>

  <nav class="container mobile-nav" id="mobile-nav" aria-label="Mobile">
    <div class="mobile-search" aria-label="Site search">
      <Search id="pagefind-search-mobile" />
    </div>
    {links.map((link) => (
      <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
    <a class="btn btn-primary" href="tel:+14807666017">Call (480) 766-6017</a>
  </nav>
</header>


<script is:inline>
  (function () {
    function initOne(el) {
      if (!el || el.getAttribute('data-ready') === 'true') return;
      if (typeof window.PagefindUI !== 'function') return;
      new window.PagefindUI({
        element: '#' + el.id,
        showImages: false,
        showSubResults: true,
        resetStyles: false,
      });
      el.setAttribute('data-ready', 'true');
    }

    function initAll() {
      document.querySelectorAll('[data-pagefind-mount]').forEach(initOne);
    }

    function loadPagefindUi() {
      var cssHref = '/pagefind/pagefind-ui.css';
      var jsHref = '/pagefind/pagefind-ui.js';

      fetch(jsHref, { method: 'HEAD' })
        .then(function (res) {
          if (!res.ok) return;
          if (!document.querySelector('link[href="' + cssHref + '"]')) {
            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = cssHref;
            document.head.appendChild(link);
          }
          if (!document.querySelector('script[data-pagefind-ui]')) {
            var script = document.createElement('script');
            script.src = jsHref;
            script.setAttribute('data-pagefind-ui', 'true');
            script.onload = initAll;
            document.head.appendChild(script);
          } else {
            initAll();
          }
        })
        .catch(function () {});
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadPagefindUi);
    } else {
      loadPagefindUi();
    }
  })();
</script>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
