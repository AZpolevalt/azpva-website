---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Lite Membership"
  description="Lite clinic membership at Arizona Pole Vault Academy — $199/month for 1 coached clinic per week, ages 10–22, Queen Creek."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Clinic membership</p>
      <h1>Lite — $199 / month</h1>
      <p style="color: rgba(255,255,255,0.85); max-width: 55ch">
        For vaulters in other sports and activities who don’t have time for Elite — access to
        <strong>one clinic per week</strong> (choose which clinic each week).
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <h2>What’s included</h2>
      <ul class="list-check">
        <li>Access to <strong>one clinic per week</strong></li>
        <li>Open to all ability levels from beginner to expert (ages 10–22)*</li>
        <li>Every session is coached</li>
        <li>Access to an extensive pole inventory</li>
      </ul>
      <p>
        <strong>First-timers</strong> must complete a
        <a href="/memberships/semi-private">semi-private session</a> before joining group clinics.
      </p>
      <p class="muted">* Post-collegiate and masters vaulters: call for additional training options.</p>

      <h2>Month-to-month</h2>
      <p>
        Lite is month-to-month. To cancel or downgrade, contact us at least
        <strong>2 days before the end of the month</strong> at
        <a href="tel:+14807666017">(480) 766-6017</a> or
        <a href="mailto:arizonapolevaultacademy@gmail.com">arizonapolevaultacademy@gmail.com</a>
        and wait for confirmation.
      </p>

      <h2>How to join</h2>
      <p>
        Call <a href="tel:+14807666017"><strong>(480) 766-6017</strong></a>. Staff will confirm Lite benefits and set you up
        on PushPress to reserve clinics.
      </p>
      <p>
        <a class="btn btn-secondary" href="/memberships">Compare all options</a>
        <a class="btn btn-primary" href="/schedule" style="margin-left: 0.5rem">View calendar</a>
      </p>
    </div>
  </section>
</BaseLayout>
