---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Lite Membership"
  description="Lite membership at Arizona Pole Vault Academy — about $199/month for flexible vault training with AZPVA coaches in Queen Creek."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Membership</p>
      <h1>Lite — ~$199 / month</h1>
      <p style="color: rgba(255,255,255,0.85); max-width: 55ch">
        A flexible membership for developing athletes and families who want AZPVA coaching without the Elite monthly rate.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <h2>Who Lite is for</h2>
      <p>
        Athletes building foundations, balancing busy schedules, or stepping into club vault for the first seasons —
        with the same coaching staff and Queen Creek facility as Elite.
      </p>
      <h2>What’s included</h2>
      <ul class="list-check">
        <li>Membership access to scheduled training (details confirmed at enrollment)</li>
        <li>Coaching from AZPVA staff</li>
        <li>Facility training environment purpose-built for pole vault</li>
      </ul>
      <h2>How to join</h2>
      <p>
        Call <a href="tel:+14807666017"><strong>(480) 766-6017</strong></a>. Staff will confirm current Lite benefits and get you into
        <a href="https://azpva.pushpress.com" target="_blank" rel="noopener noreferrer">PushPress</a> for reservations.
      </p>
      <p><a class="btn btn-secondary" href="/memberships">Compare all options</a></p>
    </div>
  </section>
</BaseLayout>
