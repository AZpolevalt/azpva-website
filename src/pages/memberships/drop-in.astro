---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Drop-in Sessions"
  description="Drop-in pole vault sessions at Arizona Pole Vault Academy — $55 per session for visiting athletes."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Training options</p>
      <h1>Drop-in Sessions — $55</h1>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p>
        Visiting Arizona or testing the facility? Drop-in sessions let athletes train with AZPVA on a per-session basis when space allows.
      </p>
      <p>
        Availability varies — call <a href="tel:+14807666017"><strong>(480) 766-6017</strong></a> before you come, and bring spikes plus any preferred poles.
      </p>
      <p><a class="btn btn-primary" href="/memberships">See memberships</a></p>
    </div>
  </section>
</BaseLayout>
