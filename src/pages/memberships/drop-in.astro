---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Drop-in Clinics"
  description="Drop-in pole vault clinics at Arizona Pole Vault Academy — $55 per clinic for visiting athletes when space allows."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Training options</p>
      <h1>Drop-in — $55 / clinic</h1>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p>
        Drop-ins are allowed during normally scheduled clinics when space is available — typically for athletes who live out of the area
        or cannot commit to an ongoing clinic membership.
      </p>
      <ul class="list-check">
        <li>Open to all ability levels from beginner to expert (ages 10–22)*</li>
        <li>Every session is coached</li>
        <li>Access to extensive pole inventory</li>
        <li>Absolute beginners: a semi-private is required before joining group clinics</li>
      </ul>
      <p class="muted">* Post-collegiate and masters vaulters: call for additional options.</p>
      <p>
        Availability varies — call <a href="tel:+14807666017"><strong>(480) 766-6017</strong></a> before you come.
      </p>
      <p>
        <a
          class="btn btn-primary"
          href="https://azpva.pushpress.com/landing/plans/plan_db18ad4eb792aa"
          target="_blank"
          rel="noopener"
        >Register online — $55</a>
        <a class="btn btn-secondary" href="/memberships" style="margin-left: 0.5rem">See memberships</a>
      </p>
    </div>
  </section>
</BaseLayout>
