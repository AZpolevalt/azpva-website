---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Semi-Private Sessions"
  description="Semi-private pole vault sessions at AZPVA — $99 and pack options for focused technique work in Queen Creek."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Training options</p>
      <h1>Semi-Private Sessions</h1>
      <p style="color: rgba(255,255,255,0.85)">$99 sessions and multi-session packs for focused technique work.</p>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p>
        Semi-privates are ideal for first-timers, athletes returning from time off, or anyone who needs a tighter coach-to-athlete ratio
        before jumping into group membership training.
      </p>
      <ul class="list-check">
        <li>Focused technical coaching</li>
        <li>Great on-ramp before Elite or Lite</li>
        <li>Pack pricing available — ask staff</li>
      </ul>
      <p>Call <a href="tel:+14807666017"><strong>(480) 766-6017</strong></a> to book.</p>
    </div>
  </section>
</BaseLayout>
