---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Semi-Private Sessions"
  description="Semi-private pole vault sessions at AZPVA — small-group onboarding and focused technique work (max 3–4 vaulters) in Queen Creek."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Training options</p>
      <h1>Semi-Private Sessions</h1>
      <p style="color: rgba(255,255,255,0.85)">
        A great way to get started vaulting — or to get highly focused work in a small group.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p>
        Semi-privates are ideal for first-timers (required before joining Elite or Lite group clinics), athletes returning from time off,
        or anyone who needs a tighter coach-to-athlete ratio.
      </p>
      <ul class="list-check">
        <li>Open to all ability and age levels</li>
        <li>Every session is coached</li>
        <li>Access to extensive pole inventory</li>
        <li>Maximum of 3–4 vaulters in a session</li>
        <li>Package pricing available — ask staff</li>
      </ul>
      <p>Call <a href="tel:+14807666017"><strong>(480) 766-6017</strong></a> to book.</p>
    </div>
  </section>
</BaseLayout>
