---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Semi-Private Sessions"
  description="Semi-private pole vault sessions at AZPVA — $99 per session, packages available. Small-group onboarding and focused technique (max 3–4 vaulters) in Queen Creek."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Training options</p>
      <h1>Semi-Private Sessions</h1>
      <p style="color: rgba(255,255,255,0.85)">
        A great way to get started vaulting — or to get highly focused work in a small group.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p>
        Semi-privates are ideal for first-timers (required before joining Elite or Lite group clinics), athletes returning from time off,
        or anyone who needs a tighter coach-to-athlete ratio. Sessions last about 90 minutes.
      </p>
      <ul class="list-check">
        <li>Available to any and all skill levels and ages</li>
        <li>Every session is coached</li>
        <li>Access to extensive pole inventory</li>
        <li>Maximum of 3–4 vaulters in a session</li>
        <li>Flexible scheduling — book with staff</li>
      </ul>

      <h2>Pricing</h2>
      <ul class="list-check">
        <li><strong>1 session — $99</strong> per vaulter</li>
        <li><strong>5 sessions — $399</strong> (save $96)</li>
        <li><strong>10 sessions — $749</strong> (save $250)</li>
      </ul>
      <p>All sessions must be paid in advance at booking.</p>
      <p>Call or text <a href="tel:+14807666017"><strong>(480) 766-6017</strong></a> to schedule.</p>
    </div>
  </section>
</BaseLayout>
