---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Elite Membership"
  description="Elite clinic membership at Arizona Pole Vault Academy — $349/month for 3 coached clinics per week, ages 10–22, Queen Creek."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Clinic membership</p>
      <h1>Elite — $349 / month</h1>
      <p style="color: rgba(255,255,255,0.85); max-width: 55ch">
        Our most effective and popular membership: access to <strong>3 clinics per week</strong>, every session coached,
        with extensive pole inventory access.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <h2>What’s included</h2>
      <ul class="list-check">
        <li>Access to <strong>3 clinics per week</strong></li>
        <li>Open to all ability levels from beginner to expert (ages 10–22)*</li>
        <li>Every session is coached</li>
        <li>Access to an extensive pole inventory</li>
        <li>Borrow poles for meets free of charge</li>
      </ul>
      <p>
        <strong>First-timers</strong> must complete a
        <a href="/memberships/semi-private">semi-private session</a> before joining group clinics.
      </p>
      <p class="muted">* Post-collegiate and masters vaulters: call for additional training options.</p>

      <h2>Month-to-month</h2>
      <p>
        Elite is month-to-month with no long-term commitment. To cancel or downgrade, text/call
        <a href="tel:+14807666017">(480) 766-6017</a> or email
        <a href="mailto:arizonapolevaultacademy@gmail.com">arizonapolevaultacademy@gmail.com</a>
        at least <strong>2 days before the end of the month</strong> and confirm you receive a reply.
      </p>

      <h2>How to join</h2>
      <p>
        Call <a href="tel:+14807666017"><strong>(480) 766-6017</strong></a> to enroll.
        After enrollment, staff will get you set up on <strong>PushPress</strong> so you can
        <strong>reserve clinics</strong> — do not arrive without a reservation.
      </p>
      <p>
        <a class="btn btn-primary" href="/contact">Contact the academy</a>
        <a class="btn btn-secondary" href="/schedule" style="margin-left: 0.5rem">View calendar</a>
      </p>
    </div>
  </section>
</BaseLayout>
