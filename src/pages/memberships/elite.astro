---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Elite Membership"
  description="Elite membership at Arizona Pole Vault Academy — about $349/month for priority training access and full facility use in Queen Creek."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Membership</p>
      <h1>Elite — ~$349 / month</h1>
      <p style="color: rgba(255,255,255,0.85); max-width: 55ch">
        Flagship membership for athletes who want consistent vault volume, priority access, and full use of the AZPVA facility.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <h2>Who Elite is for</h2>
      <p>
        Competitive high school, collegiate, and post-collegiate athletes who train weekly and want the full AZPVA experience —
        coaching, pits, runway space, and a deep pole inventory.
      </p>
      <h2>What’s included</h2>
      <ul class="list-check">
        <li>Priority access to training sessions (reserve in PushPress)</li>
        <li>Full facility access: pits, track lanes, weight room</li>
        <li>Pole fleet access appropriate to your plan and ability</li>
        <li>Coaching from AZPVA staff across group sessions</li>
      </ul>
      <h2>How to join</h2>
      <p>
        Call <a href="tel:+14807666017"><strong>(480) 766-6017</strong></a> to enroll.
        After enrollment, download the
        <a href="https://azpva.pushpress.com" target="_blank" rel="noopener noreferrer">PushPress member app</a>
        to reserve sessions.
      </p>
      <p><a class="btn btn-primary" href="/contact">Contact the academy</a></p>
    </div>
  </section>
</BaseLayout>
