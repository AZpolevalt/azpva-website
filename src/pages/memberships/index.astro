---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Memberships & Clinics"
  description="Compare Elite ($349/mo, 3 clinics/week) and Lite ($199/mo, 1 clinic/week) at Arizona Pole Vault Academy, plus semi-private, mini clinic, and drop-in options."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Join AZPVA</p>
      <h1>Memberships & Clinics</h1>
      <p class="lead" style="color: rgba(255,255,255,0.85); max-width: 50ch">
        Elite and Lite are month-to-month clinic memberships. Enroll by phone, then reserve clinics via PushPress
        using the install link staff sends after you join.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="muted" style="max-width: 70ch; margin-bottom: 1.5rem">
        There are no long-term commitments and no penalties for downgrading or canceling. To cancel or downgrade,
        text/call <a href="tel:+14807666017">(480) 766-6017</a> or email
        <a href="mailto:arizonapolevaultacademy@gmail.com">arizonapolevaultacademy@gmail.com</a>
        at least <strong>2 days before the end of the month</strong> and wait for a confirmation.
      </p>

      <div class="card-grid cols-2">
        <article class="card">
          <h3>Elite</h3>
          <p class="price">$349 <span>/ month</span></p>
          <p>Our most popular clinic membership — access to <strong>3 clinics per week</strong> with full facility and pole inventory access.</p>
          <ul class="list-check">
            <li>3 coached clinics / week</li>
            <li>Ages 10–22 (beginner to expert)*</li>
            <li>Borrow poles for meets free of charge</li>
            <li>First-timers: semi-private required before group clinics</li>
          </ul>
          <a class="btn btn-primary" href="/memberships/elite">Elite details</a>
        </article>
        <article class="card">
          <h3>Lite</h3>
          <p class="price">$199 <span>/ month</span></p>
          <p>For vaulters balancing other sports and activities — access to <strong>1 clinic per week</strong> (choose which clinic each week).</p>
          <ul class="list-check">
            <li>1 coached clinic / week</li>
            <li>Ages 10–22 (beginner to expert)*</li>
            <li>Extensive pole inventory access</li>
            <li>First-timers: semi-private required before group clinics</li>
          </ul>
          <a class="btn btn-secondary" href="/memberships/lite">Lite details</a>
        </article>
      </div>
      <p class="muted" style="margin-top: 0.75rem">* Post-collegiate and masters vaulters: call for additional training options.</p>

      <div class="card-grid cols-2" style="margin-top: 1.5rem">
        <article class="card">
          <h3>Semi-Private</h3>
          <p class="price">$99 <span>/ session</span></p>
          <p>Focused small-group sessions (max 3–4). Packages: 5 for $399 · 10 for $749.</p>
          <a class="btn btn-secondary" href="/memberships/semi-private">Semi-private details</a>
        </article>
        <article class="card">
          <h3>Mini Clinic</h3>
          <p class="price">$99 <span>/ session</span></p>
          <p>Same pricing as semi-private, with <strong>3–5 athletes</strong> for NCAA-safe group coaching. Packages: 5 for $399 · 10 for $749. Dates posted 14 days ahead.</p>
          <ul class="list-check">
            <li>Fri Oct 2 · 5:00–6:30 PM</li>
            <li>Fri Oct 16 · 5:00–6:30 PM</li>
          </ul>
          <a class="btn btn-secondary" href="/memberships/mini-clinic">Mini Clinic details</a>
        </article>
      </div>

      <div class="table-wrap" style="margin-top: 2rem">
        <table class="compare">
          <thead>
            <tr>
              <th>Option</th>
              <th>Price</th>
              <th>Best for</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Elite</strong></td>
              <td>$349 / mo · 3 clinics/week</td>
              <td>Competitive weekly clinic volume</td>
              <td><a href="/memberships/elite">Details</a></td>
            </tr>
            <tr>
              <td><strong>Lite</strong></td>
              <td>$199 / mo · 1 clinic/week</td>
              <td>Developing / busy multi-sport schedules</td>
              <td><a href="/memberships/lite">Details</a></td>
            </tr>
            <tr>
              <td><strong>Semi-Private</strong></td>
              <td>$99 · packs $399 / $749</td>
              <td>First-timers & focused technique (max 3–4)</td>
              <td><a href="/memberships/semi-private">Details</a></td>
            </tr>
            <tr>
              <td><strong>Mini Clinic</strong></td>
              <td>$99 · packs $399 / $749</td>
              <td>Small group · min 3 / max 5 (NCAA-safe)</td>
              <td><a href="/memberships/mini-clinic">Details</a></td>
            </tr>
            <tr>
              <td><strong>Drop-in</strong></td>
              <td>$55 / clinic</td>
              <td>Visiting athletes (space permitting)</td>
              <td><a href="/memberships/drop-in">Details</a></td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="muted" style="margin-top: 1.5rem">
        Full Elite/Lite policies: <a href="/memberships/terms"><strong>Membership Terms</strong></a>.
      </p>

      <div class="cta-band" style="margin-top: 2rem">
        <div>
          <h2 style="margin:0 0 0.4rem">Enroll by phone</h2>
          <p style="margin:0; color: rgba(255,255,255,0.9)">Staff will help you pick Elite vs Lite and set up PushPress so you can reserve clinics.</p>
        </div>
        <a class="btn btn-gold" href="tel:+14807666017">(480) 766-6017</a>
      </div>
    </div>
  </section>
</BaseLayout>
