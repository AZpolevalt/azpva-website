---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Memberships"
  description="Compare Elite ($349/mo) and Lite ($199/mo) memberships at Arizona Pole Vault Academy, plus semi-private and drop-in options."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Join AZPVA</p>
      <h1>Memberships</h1>
      <p class="lead" style="color: rgba(255,255,255,0.85); max-width: 50ch">
        Enroll by phone. Once you’re a member, reserve sessions in the
        <a href="https://azpva.pushpress.com" target="_blank" rel="noopener noreferrer" style="color: var(--gold)">PushPress app</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-2">
        <article class="card">
          <h3>Elite</h3>
          <p class="price">$349 <span>/ month</span></p>
          <p>Our flagship membership for athletes who want consistent access, full facility use, and competitive preparation.</p>
          <ul class="list-check">
            <li>Priority training access</li>
            <li>Full pole fleet & pits</li>
            <li>Best for competitive HS / collegiate</li>
          </ul>
          <a class="btn btn-primary" href="/memberships/elite">Elite details</a>
        </article>
        <article class="card">
          <h3>Lite</h3>
          <p class="price">$199 <span>/ month</span></p>
          <p>A flexible membership for developing athletes and families who want AZPVA coaching without the Elite monthly commitment.</p>
          <ul class="list-check">
            <li>Lower monthly rate</li>
            <li>Same coaching staff & facility</li>
            <li>Ideal for developing schedules</li>
          </ul>
          <a class="btn btn-secondary" href="/memberships/lite">Lite details</a>
        </article>
      </div>

      <div class="table-wrap" style="margin-top: 2rem">
        <table class="compare">
          <thead>
            <tr>
              <th>Option</th>
              <th>Price</th>
              <th>Best for</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Elite</strong></td>
              <td>~$349 / mo</td>
              <td>Competitive weekly training</td>
              <td><a href="/memberships/elite">Details</a></td>
            </tr>
            <tr>
              <td><strong>Lite</strong></td>
              <td>~$199 / mo</td>
              <td>Developing / flexible schedules</td>
              <td><a href="/memberships/lite">Details</a></td>
            </tr>
            <tr>
              <td><strong>Semi-Private</strong></td>
              <td>$99 + packs</td>
              <td>First-timers & focused technique</td>
              <td><a href="/memberships/semi-private">Details</a></td>
            </tr>
            <tr>
              <td><strong>Drop-in</strong></td>
              <td>$55 / session</td>
              <td>Visiting athletes</td>
              <td><a href="/memberships/drop-in">Details</a></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="cta-band" style="margin-top: 2rem">
        <div>
          <h2 style="margin:0 0 0.4rem">Enroll by phone</h2>
          <p style="margin:0; color: rgba(255,255,255,0.9)">Staff will help you pick Elite vs Lite and get you into the member app.</p>
        </div>
        <a class="btn btn-gold" href="tel:+14807666017">(480) 766-6017</a>
      </div>
    </div>
  </section>
</BaseLayout>
