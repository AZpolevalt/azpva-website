---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Fall Training"
  description="AZPVA Fall Training 2026 — September 2 to December 23, Monday and Wednesday 5:00–6:30pm, capped at 20 athletes."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Seasonal program</p>
      <h1>Fall Training 2026</h1>
      <p style="color: rgba(255,255,255,0.85)">September 2 – December 23, 2026</p>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p>
        Fall Training is AZPVA’s capped evening block for athletes who want consistent Mon/Wed vault development heading into indoor and spring seasons.
      </p>
      <ul class="list-check">
        <li><strong>Days:</strong> Monday & Wednesday</li>
        <li><strong>Time:</strong> 5:00–6:30pm</li>
        <li><strong>Roster cap:</strong> 20 athletes</li>
        <li><strong>Location:</strong> 23238 S. Via Del Arroyo, Queen Creek</li>
      </ul>
      <p>
        Call <a href="tel:+14807666017"><strong>(480) 766-6017</strong></a> for availability and how Fall Training pairs with Elite or Lite membership.
      </p>
      <p>
        <a class="btn btn-primary" href="/memberships">Memberships</a>
        <a class="btn btn-secondary" href="/camps" style="margin-left: 0.5rem">Camps hub</a>
      </p>
    </div>
  </section>
</BaseLayout>
