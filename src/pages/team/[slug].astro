---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const coaches = await getCollection('coaches');
  return coaches.map((coach) => ({
    params: { slug: coach.id },
    props: { coach },
  }));
}

const { coach } = Astro.props;
const { Content } = await render(coach);
---

<BaseLayout title={coach.data.name} description={`${coach.data.name} — ${coach.data.role} at Arizona Pole Vault Academy.`}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{coach.data.role}</p>
      <h1>{coach.data.name}</h1>
      {coach.data.pbs && <p style="color: rgba(255,255,255,0.85)">{coach.data.pbs}</p>}
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      {coach.data.credentials && <p><strong>Background:</strong> {coach.data.credentials}</p>}
      <Content />
      <p style="margin-top: 2rem"><a class="btn btn-secondary" href="/team">Back to team</a></p>
    </div>
  </section>
</BaseLayout>
