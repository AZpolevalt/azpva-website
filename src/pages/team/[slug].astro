---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const coaches = await getCollection('coaches');
  return coaches.map((coach) => ({
    params: { slug: coach.id },
    props: { coach },
  }));
}

const { coach } = Astro.props;
const { Content } = await render(coach);
const { portrait, actionImage, videos, image, gallery } = coach.data;
const featuredImage = image || portrait;
const hasLegacyDual = Boolean(portrait && actionImage && !gallery?.length);
---

<BaseLayout title={coach.data.name} description={`${coach.data.name} — ${coach.data.role} at Arizona Pole Vault Academy.`}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{coach.data.role}</p>
      <h1>{coach.data.name}</h1>
      {coach.data.pbs && <p style="color: rgba(255,255,255,0.85)">{coach.data.pbs}</p>}
      {featuredImage && !hasLegacyDual && (
        <div class="coach-hero-media coach-hero-media-single">
          <figure class="coach-hero-fig coach-hero-featured">
            <img
              src={featuredImage}
              alt={coach.data.name}
              width="400"
              height="480"
              loading="eager"
            />
          </figure>
        </div>
      )}
      {hasLegacyDual && (
        <div class="coach-hero-media">
          {portrait && (
            <figure class="coach-hero-fig">
              <img
                src={portrait}
                alt={`${coach.data.name} portrait`}
                width="480"
                height="600"
                loading="eager"
              />
            </figure>
          )}
          {actionImage && (
            <figure class="coach-hero-fig coach-hero-action">
              <img
                src={actionImage}
                alt={`${coach.data.name} pole vault action`}
                width="720"
                height="480"
                loading="eager"
              />
            </figure>
          )}
        </div>
      )}
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      {coach.data.credentials && <p><strong>Background:</strong> {coach.data.credentials}</p>}
      <Content />
    </div>
  </section>

  {gallery && gallery.length > 0 && (
    <section class="section" style="padding-top: 0" id="photos">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow" style="color: var(--red)">Photos</p>
            <h2>Photo gallery</h2>
          </div>
        </div>
        <div class="photo-gallery" data-photo-gallery>
          {gallery.map((src, index) => (
            <button
              type="button"
              class="photo-gallery-thumb"
              data-gallery-index={index}
              aria-label={`View photo ${index + 1} of ${gallery.length}`}
            >
              <img src={src} alt={`${coach.data.name} photo ${index + 1}`} loading="lazy" width="240" height="240" />
            </button>
          ))}
        </div>
      </div>
      <div class="photo-lightbox" data-photo-lightbox hidden>
        <div class="photo-lightbox-backdrop" data-lightbox-close tabindex="-1"></div>
        <div class="photo-lightbox-dialog" role="dialog" aria-modal="true" aria-label="Photo gallery">
          <button type="button" class="photo-lightbox-close" data-lightbox-close aria-label="Close gallery">×</button>
          <button type="button" class="photo-lightbox-nav photo-lightbox-prev" data-lightbox-prev aria-label="Previous photo">‹</button>
          <img class="photo-lightbox-img" data-lightbox-img alt="" />
          <button type="button" class="photo-lightbox-nav photo-lightbox-next" data-lightbox-next aria-label="Next photo">›</button>
          <p class="photo-lightbox-counter" data-lightbox-counter></p>
        </div>
      </div>
      <script define:vars={{ galleryImages: gallery, galleryName: coach.data.name }}>
        (function () {
          const images = galleryImages || [];
          if (!images.length) return;
          const lightbox = document.querySelector('[data-photo-lightbox]');
          if (!lightbox) return;
          const imgEl = lightbox.querySelector('[data-lightbox-img]');
          const counterEl = lightbox.querySelector('[data-lightbox-counter]');
          let index = 0;

          function show(i) {
            index = (i + images.length) % images.length;
            imgEl.src = images[index];
            imgEl.alt = `${galleryName} photo ${index + 1}`;
            counterEl.textContent = `${index + 1} / ${images.length}`;
            lightbox.hidden = false;
            document.body.style.overflow = 'hidden';
          }

          function hide() {
            lightbox.hidden = true;
            imgEl.removeAttribute('src');
            document.body.style.overflow = '';
          }

          document.querySelectorAll('[data-gallery-index]').forEach((btn) => {
            btn.addEventListener('click', () => {
              show(Number(btn.getAttribute('data-gallery-index')) || 0);
            });
          });

          lightbox.querySelectorAll('[data-lightbox-close]').forEach((el) => {
            el.addEventListener('click', hide);
          });
          lightbox.querySelector('[data-lightbox-prev]')?.addEventListener('click', (e) => {
            e.stopPropagation();
            show(index - 1);
          });
          lightbox.querySelector('[data-lightbox-next]')?.addEventListener('click', (e) => {
            e.stopPropagation();
            show(index + 1);
          });

          document.addEventListener('keydown', (e) => {
            if (lightbox.hidden) return;
            if (e.key === 'Escape') hide();
            else if (e.key === 'ArrowLeft') show(index - 1);
            else if (e.key === 'ArrowRight') show(index + 1);
          });
        })();
      </script>
    </section>
  )}

  {videos && videos.length > 0 && (
    <section class="section" style="padding-top: 0" id="videos">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow" style="color: var(--red)">Video</p>
            <h2>Competition & training highlights</h2>
          </div>
        </div>
        <div class="video-grid">
          {videos.map((video) => (
            <article class="video-card">
              <h3 class="video-title">{video.title}</h3>
              <div class="video-embed">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${video.id}`}
                  title={video.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                ></iframe>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section" style="padding-top: 0">
    <div class="container">
      <p><a class="btn btn-secondary" href="/team">Back to team</a></p>
    </div>
  </section>
</BaseLayout>
