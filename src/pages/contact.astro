---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Contact Arizona Pole Vault Academy — (480) 766-6017, arizonapolevaultacademy@gmail.com, 23238 S. Via Del Arroyo, Queen Creek AZ."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Get in touch</p>
      <h1>Contact</h1>
      <p style="color: rgba(255,255,255,0.85)">Call to enroll, ask about camps, or plan a visit.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="card">
        <h2>Academy</h2>
        <p>
          <strong>Phone:</strong>
          <a href="tel:+14807666017">(480) 766-6017</a>
        </p>
        <p>
          <strong>Email:</strong>
          <a href="mailto:arizonapolevaultacademy@gmail.com">arizonapolevaultacademy@gmail.com</a>
        </p>
        <p>
          <strong>Address:</strong><br />
          23238 S. Via Del Arroyo<br />
          Queen Creek, AZ 85142
        </p>
        <p class="muted">
          Memberships are typically enrolled by phone. Session reservations happen in the PushPress member app after you join.
        </p>
        <div style="display:flex; flex-wrap:wrap; gap:0.75rem; margin-top: 1rem">
          <a class="btn btn-primary" href="tel:+14807666017">Call now</a>
          <a class="btn btn-secondary" href="mailto:arizonapolevaultacademy@gmail.com">Email</a>
          <a class="btn btn-secondary" href="https://azpva.pushpress.com" target="_blank" rel="noopener noreferrer">Member App</a>
        </div>
      </div>

      <div class="map-placeholder">
        <div>
          <h3>Queen Creek facility</h3>
          <p class="muted">23238 S. Via Del Arroyo · Queen Creek, AZ 85142</p>
          <p>
            <a
              class="btn btn-secondary"
              href="https://maps.google.com/?q=23238+S.+Via+Del+Arroyo,+Queen+Creek,+AZ+85142"
              target="_blank"
              rel="noopener noreferrer"
            >
              Open in Google Maps
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
