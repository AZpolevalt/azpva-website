---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { getCollection } from 'astro:content';

const events = (await getCollection('events')).sort(
  (a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf()
);
---

<BaseLayout
  title="Events"
  description="AZPVA events — Reno Pole Vault Summit travel package and competitive trips with coaching support."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Compete & travel</p>
      <h1>Events</h1>
      <p style="color: rgba(255,255,255,0.85); max-width: 55ch">
        Travel packages and competition trips that keep athletes competing with AZPVA coaching support.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="card-grid cols-2">
        {events.map((event) => (
          <EventCard
            title={event.data.title}
            dates={event.data.dates}
            summary={event.data.summary}
            type={event.data.type}
            location={event.data.location}
            href={`/events/${event.id}`}
          />
        ))}
      </div>
      <article class="card" style="margin-top: 1.25rem; border-left: 4px solid var(--gold)">
        <p class="eyebrow" style="color: var(--red)">Outside the club travel list</p>
        <h2 style="margin-top: 0">Competition Opportunities calendar</h2>
        <p>
          The cards above are AZPVA travel packages. For the broader 2026–27 research calendar of meets outside the Arizona high-school and collegiate seasons — open all-comers, youth championships, masters, national high-school meets, street and beach vaults, and elite qualifying competitions — use the Competition Opportunities page.
        </p>
        <p class="muted" style="margin-bottom: 1rem">Last researched September 28, 2026. Confirm dates, standards, and entry fees on each organizer’s current information before you book travel.</p>
        <a class="btn btn-secondary" href="/competition-opportunities">View the 2026–27 calendar</a>
      </article>
    </div>
  </section>
</BaseLayout>
