---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const { registerUrl, registerLabel, officialRegisterUrl, officialRegisterLabel, status } = event.data;
const pushPressLabel = registerLabel ?? 'Sign up (PushPress)';
const officialLabel = officialRegisterLabel ?? 'Official registration';
---

<BaseLayout title={event.data.title} description={event.data.summary}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{event.data.type}</p>
      <h1>{event.data.title}</h1>
      <p style="color: rgba(255,255,255,0.85)">
        {event.data.dates}
        {event.data.location ? ` · ${event.data.location}` : ''}
      </p>
      {event.data.price && (
        <p style="margin-top: 0.75rem; color: rgba(255,255,255,0.9)">{event.data.price}</p>
      )}
      {officialRegisterUrl && (
        <>
          <p style="margin-top: 1rem; color: rgba(255,255,255,0.9); max-width: 62ch">
            Official event registration and the AZPVA signup on this page are separate.
          </p>
          <p class="event-cta-actions">
            <a class="btn btn-primary" href={officialRegisterUrl} target="_blank" rel="noopener noreferrer">
              {officialLabel}
            </a>
            {registerUrl && (
              <a class="btn btn-gold" href={registerUrl} target="_blank" rel="noopener noreferrer">
                {pushPressLabel}
              </a>
            )}
          </p>
        </>
      )}
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <Content />
      <p class="event-cta-actions" style="margin-top: 2rem">
        {officialRegisterUrl && (
          <a class="btn btn-primary" href={officialRegisterUrl} target="_blank" rel="noopener noreferrer">
            {officialLabel}
          </a>
        )}
        {registerUrl ? (
          <a
            class:list={['btn', officialRegisterUrl ? 'btn-gold' : 'btn-primary']}
            href={registerUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {pushPressLabel}
          </a>
        ) : status === 'coming-soon' || status === 'closed' ? null : (
          <a class="btn btn-primary" href="/contact">Ask about registration</a>
        )}
        <a class="btn btn-secondary" href="tel:+14807666017">Call (480) 766-6017</a>
        <a class="btn btn-secondary" href="/events">All events</a>
      </p>
    </div>
  </section>
</BaseLayout>
