---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Calendar"
  description="AZPVA clinic calendar and reservation info — reserve via PushPress before you arrive."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Members</p>
      <h1>Calendar</h1>
      <p style="color: rgba(255,255,255,0.85); max-width: 55ch">
        View upcoming clinics below. Members reserve spots through PushPress (install links are sent by staff after enrollment).
      </p>
    </div>
  </section>

  <section class="section" style="padding-bottom: 1.5rem">
    <div class="container">
      <div class="card" style="border-left: 4px solid var(--red)">
        <h2 style="margin-top: 0">Reservation required</h2>
        <p>
          Elite and Lite members must <strong>reserve a clinic spot via PushPress</strong> before arriving.
          Do not show up without a reservation — you risk not being able to vault.
        </p>
        <p class="muted" style="margin-bottom: 0">
          Need help with reservations or your PushPress account? Call or text
          <a href="tel:+14807666017"><strong>(480) 766-6017</strong></a>.
        </p>
      </div>
      <div class="card" style="border-left: 4px solid var(--gold); margin-top: 1rem" role="status">
        <h2 style="margin-top: 0">Saturday morning practice update</h2>
        <p style="margin-bottom: 0">
          Starting <strong>Saturday, September 26, 2026</strong>, Saturday morning vault practice
          is <strong>8:00–9:30 AM</strong> (was 7:00 AM). Please confirm the time in PushPress when you reserve.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="calendar-frame-wrap">
        <iframe
          class="calendar-frame"
          src="https://azpva.pushpress.com/open/calendar?framed=1"
          title="AZPVA calendar"
          width="100%"
          height="1200"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <p style="margin-top: 1.25rem">
        <a class="btn btn-primary" href="tel:+14807666017">Call for help</a>
        <a class="btn btn-secondary" href="/contact" style="margin-left: 0.5rem">Contact</a>
      </p>
    </div>
  </section>
</BaseLayout>
