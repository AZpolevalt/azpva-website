---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Schedule"
  description="How to reserve AZPVA training sessions in the PushPress member app."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Members</p>
      <h1>Schedule & Reservations</h1>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p>
        Session times and open slots live in the
        <a href="https://azpva.pushpress.com" target="_blank" rel="noopener noreferrer"><strong>PushPress member app</strong></a>.
        New athletes: call to enroll first, then staff will help you get logged in.
      </p>
      <ol>
        <li>Enroll by phone: <a href="tel:+14807666017">(480) 766-6017</a></li>
        <li>Open <a href="https://azpva.pushpress.com" target="_blank" rel="noopener noreferrer">azpva.pushpress.com</a></li>
        <li>Reserve upcoming sessions according to your membership rules</li>
      </ol>
      <p><a class="btn btn-primary" href="https://azpva.pushpress.com" target="_blank" rel="noopener noreferrer">Open Member App</a></p>
    </div>
  </section>
</BaseLayout>
