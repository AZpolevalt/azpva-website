---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const camps = await getCollection('camps');
  return camps.map((camp) => ({
    params: { slug: camp.id },
    props: { camp },
  }));
}

const { camp } = Astro.props;
const { Content } = await render(camp);
const registerUrl = camp.data.registerUrl;
---

<BaseLayout title={camp.data.title} description={camp.data.summary}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Camp</p>
      <h1>{camp.data.title}</h1>
      <p style="color: rgba(255,255,255,0.85)">{camp.data.dates}</p>
      <p style="margin-top: 0.75rem">
        <span class={`badge ${camp.data.status}`}>{camp.data.status.replace('-', ' ')}</span>
        {camp.data.price && <span style="margin-left: 0.75rem">{camp.data.price}</span>}
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <Content />
      <p style="margin-top: 2rem; display:flex; flex-wrap:wrap; gap:0.75rem">
        {registerUrl ? (
          <a class="btn btn-primary" href={registerUrl} target="_blank" rel="noopener noreferrer">Register</a>
        ) : (
          <a class="btn btn-primary" href="https://azpva.pushpress.com" target="_blank" rel="noopener noreferrer">Register via PushPress</a>
        )}
        <a class="btn btn-secondary" href="tel:+14807666017">Call (480) 766-6017</a>
        <a class="btn btn-secondary" href="/camps">All camps</a>
      </p>
    </div>
  </section>
</BaseLayout>
