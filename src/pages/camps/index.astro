---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CampCard from '../../components/CampCard.astro';
import { getCollection } from 'astro:content';

const camps = (await getCollection('camps')).sort(
  (a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf()
);
---

<BaseLayout
  title="Camps & Training"
  description="AZPVA camps and seasonal training in Queen Creek — Fall Camp, Winter Camp, Summer Camp, and Fall Training."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Programs</p>
      <h1>Camps & Training</h1>
      <p style="color: rgba(255,255,255,0.85); max-width: 55ch">
        Concentrated vault days and seasonal blocks designed for technical growth — from fall camp weekends to the Mon/Wed Fall Training roster.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="margin-bottom: 1.5rem">
        <div style="display:flex; justify-content:space-between; gap:0.75rem; align-items:start; margin-bottom:0.75rem">
          <h3>Fall Training 2026</h3>
          <span class="badge closed">closed</span>
        </div>
        <p class="muted">September 2 – December 23, 2026 · Mon/Wed 5:00–6:30pm · Cap 20</p>
        <p class="notice notice-closed" role="status" style="margin: 0.75rem 0 1rem">
          <strong>Registration closed — program in progress (entries closed Sep 16).</strong>
        </p>
        <p>Seasonal flagship group for consistent technical development. Separate from weekend camps. Not open for new registration.</p>
        <a class="btn btn-secondary" href="/fall-training">Fall Training details</a>
      </div>

      <div class="card-grid cols-2">
        {camps.map((camp) => (
          <CampCard
            title={camp.data.title}
            dates={camp.data.dates}
            summary={camp.data.summary}
            price={camp.data.price}
            status={camp.data.status}
            href={`/camps/${camp.id}`}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
