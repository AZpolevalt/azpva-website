---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CampCard from '../../components/CampCard.astro';
import { getCollection } from 'astro:content';

const camps = (await getCollection('camps')).sort(
  (a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf()
);
---

<BaseLayout
  title="Camps & Training"
  description="AZPVA camps and seasonal training in Queen Creek — Fall Camp, Winter Camp, Summer Camp, and Fall Training."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Programs</p>
      <h1>Camps & Training</h1>
      <p style="color: rgba(255,255,255,0.85); max-width: 55ch">
        Concentrated vault days and seasonal blocks designed for technical growth — from fall camp weekends to the Mon/Wed Fall Training roster.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="margin-bottom: 1.5rem">
        <h3>Fall Training 2026</h3>
        <p class="muted">September 2 – December 23, 2026 · Mon/Wed 5:00–6:30pm · Cap 20</p>
        <p>Seasonal flagship group for consistent technical development. Separate from weekend camps.</p>
        <a class="btn btn-primary" href="/fall-training">Fall Training details</a>
      </div>

      <div class="card-grid cols-2">
        {camps.map((camp) => (
          <CampCard
            title={camp.data.title}
            dates={camp.data.dates}
            summary={camp.data.summary}
            price={camp.data.price}
            status={camp.data.status}
            href={`/camps/${camp.id}`}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
